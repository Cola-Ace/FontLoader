{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FontLoader",
  "version": "0.1.6",
  "identifier": "dev.fontloader.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FontLoader",
        "url": "index.html",
        "visible": false,
        "width": 920,
        "height": 620,
        "minWidth": 760,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
